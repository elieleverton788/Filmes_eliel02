<div class="titulo-pagina">
  <h1>Filmes</h1>
  <a class="pure-button pure-button-primary" href="/filmes/cadastrar">Cadastrar filme</a>
</div>

{{#if filmes.length}}
<table class="pure-table pure-table-bordered tabela">
  <thead>
    <tr>
      <th>Título</th>
      <th>Ano</th>
      <th>Gênero</th>
      <th>Diretor</th>
      <th>Ficha</th>
      <th>Ações</th>
    </tr>
  </thead>
  <tbody>
    {{#each filmes}}
    <tr>
      <td>{{titulo}}</td>
      <td>{{anoLancamento}}</td>
      <td>{{genero}}</td>
      <td>{{#if diretor}}{{diretor.nome}}{{else}}Não informado{{/if}}</td>
      <td>{{#if fichaTecnica}}Cadastrada{{else}}Não cadastrada{{/if}}</td>
      <td class="acoes">
        <a class="pure-button" href="/filmes/detalhar/{{id}}">Detalhar</a>
        <a class="pure-button" href="/filmes/editar/{{id}}">Editar</a>
        <form action="/filmes/excluir/{{id}}" method="POST" class="form-inline">
          <input type="hidden" name="_method" value="DELETE">
          <input type="submit" class="pure-button excluir" value="Excluir">
        </form>
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>
{{else}}
<div class="aviso">Nenhum filme cadastrado.</div>
{{/if}}