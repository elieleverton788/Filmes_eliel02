<h1>Editar Artista</h1>

<form action="/artistas/editar/{{artista.id}}?_method=PUT" method="POST" class="pure-form pure-form-stacked">

  <label>Nome</label>
  <input name="nome" value="{{artista.nome}}" required>

  <label>Ano de nascimento</label>
  <input name="anoNascimento" type="number" value="{{artista.anoNascimento}}" required>

  <label>Foto (URL)</label>
  <input name="foto" type="url" value="{{artista.foto}}">

  <label>Nome artístico</label>
  <input name="nomeArtistico" value="{{artista.nomeArtistico}}">

  <label>Técnicas de atuação</label>
  <textarea name="tecnicasAtuacao">{{artista.tecnicasAtuacao}}</textarea>

  <label>Em atividade?</label>
  <select name="emAtividade">
    <option value="true" {{#if artista.emAtividade}}selected{{/if}}>Sim</option>
    <option value="false" {{#unless artista.emAtividade}}selected{{/unless}}>Não</option>
  </select>

  <br>

  <input class="pure-button pure-button-primary" type="submit" value="Salvar">

  <a class="pure-button" href="/artistas/detalhar/{{artista.id}}">
    Cancelar
  </a>

</form>